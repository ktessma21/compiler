int64 findArrayValue(int64[][][] A_8, int64 v_9)
	int64 first_dimension_length_10
	int64 second_dimension_length_11
	int64 third_dimension_length_12
	first_dimension_length_10 <- length A_8 0
	second_dimension_length_11 <- length A_8 1
	third_dimension_length_12 <- length A_8 2
	int64 i_13
	i_13 <- 0
	int64 cond_17
	cond_17 <- i_13 < first_dimension_length_10
	br cond_17 :loop_1_body :leave
	:loop_1_body
	int64 j_14
	j_14 <- 0
	int64 cond_18
	cond_18 <- j_14 < second_dimension_length_11
	br cond_18 :loop_2_body :continue_loop1
	:loop_2_body
	int64 k_15
	k_15 <- 0
	int64 cond_19
	cond_19 <- k_15 < third_dimension_length_12
	br cond_19 :loop_3_body :continue_loop2
	:loop_3_body
	int64 current_value_16
	current_value_16 <- A_8[i_13][j_14][k_15]
	int64 cond_20
	cond_20 <- current_value_16 = v_9
	br cond_20 :found_value :continue_search
	:continue_search
	k_15 <- k_15 + 1
	br :loop_3_body
	:continue_loop2
	j_14 <- j_14 + 1
	br :loop_2_body
	:continue_loop1
	i_13 <- i_13 + 1
	br :loop_1_body
	:found_value
	return 1
	:leave
